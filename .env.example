# Copy to .env.local for local development. Never commit real values.
# All variables are optional: public calculators work without any of them.

# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mutual-fund NAV provider. Only "mfapi" is implemented. Set to "none" to disable NAV features.
NAV_PROVIDER=mfapi

# Upstream request timeout in milliseconds (bounded server-side to 2000–15000).
NAV_FETCH_TIMEOUT_MS=8000

# Optional shared storage (Upstash Redis) for last-known-good NAVs and automation run history.
# Used ONLY when both the URL (https://…) and the token are set; otherwise everything stays in memory per instance.
# The Vercel Marketplace integration may inject KV_REST_API_URL / KV_REST_API_TOKEN instead; those are accepted too.
# Server-only secrets: never prefix with NEXT_PUBLIC_. See docs/owner-actions/storage-options.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret that authorizes GET /api/cron/validate-mf-data (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
# Must be at least 32 characters, or every request is refused (fails closed). Placeholder only — generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Server-only; never NEXT_PUBLIC_.
# The placeholder below is deliberately too short, so a copied example can never authorize a run.
CRON_SECRET=CHANGE_ME

# Kill switch for the scheduled MF data-quality task. "true" makes runs report 'skipped-disabled' and fetch nothing.
MF_VALIDATION_DISABLED=false
