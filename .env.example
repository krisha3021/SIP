# Copy to .env.local for local development. Never commit real values.
# All variables are optional: public calculators work without any of them.

# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mutual-fund NAV provider. Only "mfapi" is implemented. Set to "none" to disable NAV features.
NAV_PROVIDER=mfapi

# Upstream request timeout in milliseconds (bounded server-side to 2000–15000).
NAV_FETCH_TIMEOUT_MS=8000

# Optional shared cache for last-known-good NAV data and rate limiting (Phase 3+).
# Leave empty to use per-instance in-memory caching only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to authorize scheduled ingestion endpoints (Phase 3+). Generate a long random value.
CRON_SECRET=
