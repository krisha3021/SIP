# Copy to .env.local for local development. Never commit real values.
# All variables are optional: public calculators work without any of them.

# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mutual-fund NAV provider. Only "mfapi" is implemented. Set to "none" to disable NAV features.
NAV_PROVIDER=mfapi

# Upstream request timeout in milliseconds (bounded server-side to 2000–15000).
NAV_FETCH_TIMEOUT_MS=8000

# Optional shared storage (Upstash Redis) for last-known-good NAVs and automation run history.
# Used ONLY when both the URL (https://…) and the token are set; otherwise everything stays in memory per instance.
# The Vercel Marketplace integration may inject KV_REST_API_URL / KV_REST_API_TOKEN instead; those are accepted too.
# Server-only secrets: never prefix with NEXT_PUBLIC_. See docs/owner-actions/storage-options.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret that authorizes GET /api/cron/validate-mf-data (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
# Must be at least 32 characters, or every request is refused (fails closed). Placeholder only — generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Server-only; never NEXT_PUBLIC_.
# The placeholder below is deliberately too short, so a copied example can never authorize a run.
CRON_SECRET=CHANGE_ME

# Kill switch for the scheduled MF data-quality task. "true" makes runs report 'skipped-disabled' and fetch nothing.
MF_VALIDATION_DISABLED=false

# ── Permissions (research-platform upgrade, 2026-10-19) ──────────────────────
# HMAC key that signs single-use, 5-minute consent tokens for external actions (currently only AI explanations).
# At least 32 characters; server-only. Unset → consent is unavailable, so every consent-gated action stays off.
CONSENT_SIGNING_SECRET=

# ── Optional AI explanations (any OpenAI-compatible endpoint; free tiers work) ──
# All three of BASE_URL (https), API_KEY and MODEL must be set, or AI explanations stay off. Server-only.
# Read the provider's data-retention/training terms first and summarise them in LLM_DATA_RETENTION_NOTE —
# the consent dialog shows that text to every visitor before anything is sent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER_NAME=
LLM_DATA_RETENTION_NOTE=
LLM_TERMS_URL=
# Requests per IST day per server instance (default 200), to stay inside free-tier limits.
LLM_DAILY_REQUEST_CAP=200

# ── Research data (all off until permission/licences exist) ──────────────────
# AMFI's terms forbid public display without written permission. Set to "true" ONLY after AMFI's written approval,
# and set the exact data URLs AMFI authorises (https on www.amfiindia.com or portal.amfiindia.com).
AMFI_REUSE_APPROVED=false
AMFI_TER_DATA_URL=
AMFI_AAUM_DATA_URL=
# Third-party ratings: provider name, and "true" only when a display + attribution licence is held.
RATINGS_PROVIDER=
RATINGS_DISPLAY_LICENSED=false
